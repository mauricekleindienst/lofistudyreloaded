# Required: MongoDB connection string (database name in the path)
MONGODB_URI=mongodb://user:password@host:27017/lofistudy?authSource=admin

# Public URL of this deployment (build-time: canonical links, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://lo-fi.study

# Optional: base URL used for OAuth redirect URIs (defaults to the request host)
# APP_URL=https://lo-fi.study

# Optional OAuth sign-in. Each provider appears only when both values are set.
# Callback URL to register: <APP_URL>/api/auth/oauth/<provider>/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional Google Analytics 4
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
